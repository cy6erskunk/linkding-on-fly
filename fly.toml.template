# fly.toml template — generate fly.toml with: source .env && envsubst < fly.toml.template > fly.toml
#
# See https://fly.io/docs/reference/configuration/ for information about how to use this file.
#

app = '${APP_NAME}'
primary_region = 'arn'

[build]

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = 'stop'
  auto_start_machines = true
  min_machines_running = 1
  processes = ['app']

[[vm]]
  memory = '256mb'
  cpu_kind = 'shared'
  cpus = 1

[env]
  LD_SERVER_PORT="8080"
  DB_PATH="/etc/linkding/data/db.sqlite3"
  LITESTREAM_REPLICA_PATH="linkding_replica.sqlite3"
  LITESTREAM_REPLICA_ENDPOINT="${LITESTREAM_REPLICA_ENDPOINT}"
  LITESTREAM_REPLICA_BUCKET="${LITESTREAM_REPLICA_BUCKET}"

[mounts]
  source = "linkding_data"
  destination = "/etc/linkding/data"
